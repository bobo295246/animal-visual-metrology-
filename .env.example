# =========================================================
# Animal Visual Metrology System (COCO + YOLO) - .env.example
# =========================================================

# Application Settings
APP_NAME="COCO Animal Segmentation & Visual Metrology API"
APP_VERSION="1.0.0"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000
DEBUG=true

# Security & Authentication (Demo Credentials)
SECRET_KEY="super-secret-jwt-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Default Test Accounts
TEST_ADMIN_USERNAME="admin"
TEST_ADMIN_PASSWORD="AdminPassword123!"
TEST_USER_USERNAME="metrology_tester"
TEST_USER_PASSWORD="TesterPassword123!"

# YOLO & Metrology Model Configuration
YOLO_SEG_MODEL="yolov8n-seg.pt"
DEFAULT_EYE_METHOD="vitpose"
YOLO_CONF_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45

# Metrology Calibration (Optional: mm per pixel scale factor)
DEFAULT_PIXEL_TO_MM_SCALE=0.25

# Paths
DATA_DIR="data"
COCO_SAMPLES_DIR="data/coco_samples"
OUTPUT_DIR="outputs"
CSV_EXPORT_PATH="data/sample_measurements.csv"

